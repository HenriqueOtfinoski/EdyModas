# Copie este arquivo para .env e preencha com os seus valores.
# O .env NUNCA vai para o GitHub (está no .gitignore).
PORT=3000

# Usuário e senha do painel (/admin). Use valores seus — os de exemplo abaixo são recusados.
# A senha precisa ter 10 ou mais caracteres. Depois de entrar, dá para trocá-la pelo painel.
ADMIN_USER=escolha-um-usuario
ADMIN_PASSWORD=escolha-uma-senha-forte

# Em hospedagem com HTTPS, descomente:
# NODE_ENV=production
